generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  resetHour       Int              @default(5)
  resetMinute     Int              @default(0)
  resetEnabled    Boolean          @default(true)
  reportEmail     String?
  reportHour      Int              @default(6)
  reportMinute    Int              @default(0)
  reportEnabled   Boolean          @default(false)
  users           User[]
  tasks           Task[]
  temperatureLogs TemperatureLog[]
  resetLogs       ResetLog[]
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  role      String  @default("staff")
  pushToken String?
  department String?
  regionId   Int?
  areaId     Int?
  siteId    Int?
  site      Site?   @relation(fields: [siteId], references: [id])
  tasks     Task[]
}

model Task {
  id             Int       @id @default(autoincrement())
  name           String
  completed      Boolean   @default(false)
  completedAt    DateTime?
  templateId     Int?
  taskDate       String?
  assignedUserId Int?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id])
  siteId         Int?
  site           Site?     @relation(fields: [siteId], references: [id])

  department     String    @default("kitchen")
  frequency      String    @default("daily")

  dueAt              DateTime?
  escalationLevel    Int       @default(0)
  lastEscalatedAt    DateTime?
}

model TemperatureLog {
  id           Int      @id @default(autoincrement())
  fridge       String
  value        Float
  type         String   @default("fridge")
  status       String   @default("green")
  acknowledged Boolean  @default(false)
  siteId       Int?
  site         Site?    @relation(fields: [siteId], references: [id])
  createdAt    DateTime @default(now())
}

model ResetLog {
  id         Int      @id @default(autoincrement())
  siteId     Int
  site       Site     @relation(fields: [siteId], references: [id])
  resetCount Int
  ranAt      DateTime @default(now())
}

model TaskTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  department  String  @default("kitchen")
  frequency   String  @default("daily")
  autoCreate  Boolean @default(false)
  schedule    String?
}