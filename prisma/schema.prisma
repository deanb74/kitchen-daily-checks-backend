generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  venueType       String?
  resetHour       Int              @default(5)
  resetMinute     Int              @default(0)
  resetEnabled    Boolean          @default(true)
  reportEmail     String?
  reportHour      Int              @default(6)
  reportMinute    Int              @default(0)
  reportEnabled   Boolean          @default(false)
  users           User[]
  tasks           Task[]
  temperatureLogs TemperatureLog[]
  resetLogs       ResetLog[]
  areas           Area[]
  equipment       Equipment[]
  documents       SiteDocument[]
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  role      String  @default("staff")
  pushToken String?
  department String?
  regionId   Int?
  areaId     Int?
  siteId    Int?
  site      Site?   @relation(fields: [siteId], references: [id])
  tasks     Task[]
}

model Task {
  id             Int       @id @default(autoincrement())
  name           String
  completed      Boolean   @default(false)
  completedAt    DateTime?
  templateId     Int?
  taskDate       String?
  assignedUserId Int?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id])
  siteId         Int?
  site           Site?     @relation(fields: [siteId], references: [id])

  department     String    @default("kitchen")
  frequency      String    @default("daily")

  dueAt              DateTime?
  escalationLevel    Int       @default(0)
  lastEscalatedAt    DateTime?
  completedById      Int?
  completedByEmail   String?
}

model TemperatureLog {
  id           Int      @id @default(autoincrement())
  fridge       String
  value        Float
  type         String   @default("fridge")
  status       String   @default("green")
  acknowledged Boolean  @default(false)
  siteId       Int?
  site         Site?    @relation(fields: [siteId], references: [id])
  createdAt    DateTime @default(now())
}

model ResetLog {
  id         Int      @id @default(autoincrement())
  siteId     Int
  site       Site     @relation(fields: [siteId], references: [id])
  resetCount Int
  ranAt      DateTime @default(now())
}

model TaskTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  department  String  @default("kitchen")
  frequency   String  @default("daily")
  areaId      Int?
  equipmentId Int?
  venueType   String?
  autoCreate  Boolean @default(false)
  schedule    String?
  dueHour     Int?
  dueMinute   Int?
  safeMethodId            Int?
  verificationRequired    Boolean @default(false)
  managerSignoffRequired  Boolean @default(false)
  correctiveActionPrompt  String?

  safeMethod              SafeMethod? @relation(fields: [safeMethodId], references: [id])
}

model Shift {
  id             Int       @id @default(autoincrement())
  userId         Int
  siteId         Int?
  department     String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  handoverNotes  String?
}

model SafeMethod {
  id            Int            @id @default(autoincrement())
  title         String
  category      String
  description   String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  taskTemplates TaskTemplate[]
}

model ComplianceRecord {
  id               Int      @id @default(autoincrement())
  taskId           Int?
  userId           Int
  siteId           Int?

  type             String
  value            String?
  notes            String?
  correctiveAction String?
  verified         Boolean  @default(false)

  createdAt        DateTime @default(now())
}

model Area {
  id        Int         @id @default(autoincrement())
  siteId    Int
  name      String
  category  String?
  active    Boolean     @default(true)

  site      Site        @relation(fields: [siteId], references: [id])
  equipment Equipment[]
}

model Equipment {
  id      Int     @id @default(autoincrement())
  siteId  Int
  areaId  Int?

  name    String
  type    String?
  active  Boolean @default(true)

  site    Site  @relation(fields: [siteId], references: [id])
  area    Area? @relation(fields: [areaId], references: [id])
}

model SiteDocument {
  id           Int      @id @default(autoincrement())
  siteId       Int

  title        String
  type         String?
  language     String?

  fileUrl      String?
  thumbnailUrl String?

  source       String?  // upload, photo, generated
  status       String?  // stored, pending_ocr, imported

  createdById  Int?

  createdAt    DateTime @default(now())

  site         Site @relation(fields: [siteId], references: [id])
}